# AWS CDK Deployment Configuration
CDK_DEFAULT_ACCOUNT=123456789012
CDK_DEFAULT_REGION=ap-northeast-1

# OpenAI Configuration
OPENAI_API_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=your-openai-api-key-here

# Firecrawl Configuration
FIRECRAWL_API_BASE_URL=https://api.firecrawl.dev/v1
FIRECRAWL_API_KEY=your-firecrawl-api-key-here

# AWS Bedrock Configuration (将来用)
BEDROCK_API_BASE_URL=https://bedrock-runtime.ap-northeast-1.amazonaws.com
BEDROCK_API_KEY_NAME=bedrock-api-key

# Dify Configuration (将来用)
DIFY_API_BASE_URL=https://api.dify.ai/v1
DIFY_API_KEY_NAME=dify-api-key

# Developer Usage Plan Configuration
DEVELOPER_PLAN_THROTTLE_RATE_LIMIT=1000
DEVELOPER_PLAN_THROTTLE_BURST_LIMIT=2000
DEVELOPER_PLAN_QUOTA_LIMIT=100000
DEVELOPER_PLAN_QUOTA_PERIOD=DAY

# Basic Usage Plan Configuration
BASIC_PLAN_THROTTLE_RATE_LIMIT=100
BASIC_PLAN_THROTTLE_BURST_LIMIT=200
BASIC_PLAN_QUOTA_LIMIT=1000
BASIC_PLAN_QUOTA_PERIOD=DAY

# CloudWatch Configuration
ENABLE_CLOUDWATCH_LOGS=true
ENABLE_DETAILED_METRICS=true
ENABLE_XRAY_TRACING=true

# CORS Configuration
CORS_ALLOW_ORIGINS=*
CORS_ALLOW_HEADERS=Content-Type,X-Amz-Date,Authorization,X-Api-Key,X-Amz-Security-Token
CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,OPTIONS